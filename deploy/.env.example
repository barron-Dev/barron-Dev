# Cyclothone production runtime contract.
# Copy to deploy/.env locally; never commit deploy/.env.

# Required server credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # legacy fallback supported by the client

# Region control
CYCLOTHONE_REGION=

# Federation: required only when federation is enabled
# Must be a high-entropy value of at least 32 bytes.
CYCLOTHONE_FED_SALT=

# Provider/auth references are identifiers resolved by the configured secret store.
# Do not put provider passwords, private keys, cookies, or bearer tokens here unless
# the application explicitly documents that variable as a secret value.

# Optional runtime controls
CYCLOTHONE_LOG_LEVEL=INFO
