FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml requirements-server.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt -r requirements-ml.txt

COPY src ./src

RUN useradd --system --uid 10001 --create-home sentinel \
    && chown -R sentinel:sentinel /app
USER sentinel

EXPOSE 8000

CMD ["uvicorn", "sentinel.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
