{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclothone.online/schemas/reference-pack.schema.json",
  "title": "Cyclothone Declarative Reference Pack",
  "description": "Declarative configuration of existing Cyclothone primitives. A pack does not create platform capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pack_id", "industry", "sub_segment", "geography",
    "asset_types", "services_in_scope", "policy_pack", "compliance_packs",
    "delivery_bindings", "data_residency", "retention", "approval",
    "workflows", "failure_tests", "ttfvr_target_seconds"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "industry": { "$ref": "#/$defs/identifier" },
    "sub_segment": { "$ref": "#/$defs/identifier" },
    "geography": { "$ref": "#/$defs/identifier" },
    "asset_types": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["scope"],
        "properties": {
          "scope": { "enum": ["critical", "high", "medium", "low"] },
          "observe_only": { "type": "boolean" },
          "third_party": { "type": "boolean" },
          "session_theft": { "type": "boolean" }
        }
      }
    },
    "services_in_scope": {
      "type": "object", "additionalProperties": false, "required": ["required", "optional"],
      "properties": {
        "required": { "$ref": "#/$defs/identifierList" },
        "optional": { "$ref": "#/$defs/identifierList" }
      }
    },
    "policy_pack": {
      "type": "object", "additionalProperties": false, "required": ["base", "overlays"],
      "properties": { "base": { "$ref": "#/$defs/identifier" }, "overlays": { "$ref": "#/$defs/identifierList" } }
    },
    "compliance_packs": { "$ref": "#/$defs/identifierList" },
    "delivery_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["default", "allowed", "forbidden"],
      "properties": {
        "default": { "$ref": "#/$defs/identifier" },
        "allowed": { "$ref": "#/$defs/identifierList" },
        "forbidden": { "$ref": "#/$defs/identifierList" }
      }
    },
    "data_residency": {
      "type": "object", "additionalProperties": false,
      "required": ["default_region", "cross_border_forbidden"],
      "properties": {
        "default_region": { "$ref": "#/$defs/identifier" },
        "cross_border_forbidden": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false, "required": ["min_days", "worm"],
      "properties": { "min_days": { "type": "integer", "minimum": 0 }, "worm": { "type": "boolean" } }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["dual_control", "roles"],
      "properties": { "dual_control": { "type": "boolean" }, "roles": { "$ref": "#/$defs/identifierList" } }
    },
    "workflows": { "$ref": "#/$defs/identifierList", "minItems": 1 },
    "failure_tests": { "$ref": "#/$defs/identifierList", "minItems": 1 },
    "ttfvr_target_seconds": { "type": "integer", "minimum": 1 },
    "controls": { "type": "object", "description": "Industry-specific declarative controls; values are not enforcement until bound to a verified primitive." },
    "patterns": { "type": "array", "items": { "type": "string" } },
    "developer_profile": { "type": "object" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "identifierList": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  }
}
